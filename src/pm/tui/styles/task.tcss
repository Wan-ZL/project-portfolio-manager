/* Task view specific styles */

TaskScreen {
    layout: vertical;
}

#task-title {
    dock: top;
    height: 3;
    content-align: center middle;
    background: $primary-background-darken-1;
    color: $primary-lighten-2;
    text-style: bold;
    border-bottom: solid $primary 40%;
    padding: 0 2;
}

#task-body {
    layout: horizontal;
    height: 1fr;
}

/* Left panel — session info */
#task-info-panel {
    width: 25%;
    min-width: 24;
    border-right: solid $primary 30%;
    background: $surface-darken-1;
    padding: 1 1;
}

#task-info-panel .info-label {
    color: $text-muted;
    height: 1;
}

#task-info-panel .info-value {
    color: $text;
    height: 1;
    padding: 0 0 0 1;
}

.info-section-header {
    color: $primary;
    text-style: bold;
    height: 2;
    padding: 1 0 0 0;
}

/* Right panel — terminal output */
#task-terminal-panel {
    width: 75%;
    background: $surface;
    padding: 0;
}

#terminal-output {
    width: 100%;
    height: 100%;
    padding: 0 1;
    background: #0c0c0c;
    color: #cccccc;
}

#terminal-scroll {
    width: 100%;
    height: 100%;
}
