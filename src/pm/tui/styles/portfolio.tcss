/* Portfolio view -- card-based layout */

PortfolioScreen {
    layout: vertical;
}

#portfolio-title {
    dock: top;
    height: 3;
    content-align: center middle;
    background: $primary-background-darken-1;
    color: $primary-lighten-2;
    text-style: bold;
    border-bottom: solid $primary 40%;
    padding: 0 2;
}

#cards-scroll {
    height: 1fr;
    min-height: 100%;
    padding: 1 2;
}

.account-header {
    width: 100%;
    height: 2;
    padding: 0 1;
    color: $primary;
    text-style: bold;
    margin: 1 1 0 1;
}

/* Status bar */
StatusBar {
    dock: bottom;
    height: 1;
    background: $primary-background-darken-2;
    color: $text;
    padding: 0 1;
}
